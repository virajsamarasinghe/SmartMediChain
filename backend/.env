# Environment Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/smartmedichain
MONGODB_TEST_URI=mongodb://localhost:27017/smartmedichain_test

# JWT Configuration
JWT_SECRET=smartmedichain-super-secret-jwt-key-for-development-only
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=smartmedichain-refresh-token-secret-for-development
JWT_REFRESH_EXPIRE=30d

# Bcrypt Configuration
BCRYPT_SALT_ROUNDS=12

# Rate Limiting (Increased for development)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Cloudinary Configuration (Optional - for file uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Blockchain Configuration
BLOCKCHAIN_RPC_URL=http://smart-contract:8545
BLOCKCHAIN_NETWORK_URL=http://smart-contract:8545
SMART_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# AI Model API Configuration
AI_MODEL_API_URL=http://localhost:5001

# Logging
LOG_LEVEL=info